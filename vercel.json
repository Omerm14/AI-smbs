{
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.aaa-tech.com" }],
      "destination": "https://aaa-tech.com/:path*",
      "permanent": true
    },
    { "source": "/he", "destination": "/", "permanent": true },
    { "source": "/index-he.html", "destination": "/", "permanent": true }
  ]
}
